{
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "prettier.enable": false,
  "prettier.printWidth": 200,
  "prettier.semi": false,
  "prettier.singleQuote": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "eslint.codeAction.showDocumentation": {
    "enable": true
  }
}
